# =============================================================
# BACKEND — Valeurs dev par défaut
# =============================================================
# CE FICHIER EST COMMITÉ — ne jamais y mettre de secrets.
# Les vraies valeurs (credentials, clés) vont dans .env.local
# ou sont injectées par Docker via --env-file.
# =============================================================

DATABASE_URL=postgresql://user:password@localhost:5432/sauver_la_face

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_PHOTOS=photos
MINIO_USE_SSL=false

WEB_URL=http://localhost:3000
JWT_SECRET=

NODE_ENV=development
PORT=3001
