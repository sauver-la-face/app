# =============================================================
# BACKEND — Variables d'environnement
# =============================================================
# Stratégie :
#   .env          ← valeurs dev par défaut, commité (sans secrets)
#   Docker        ← injecte les overrides locaux et prod via env_file ou -e
# =============================================================

# Base de données
DATABASE_URL=postgresql://user:password@localhost:5432/sauver_la_face

# Better Auth
BETTER_AUTH_SECRET=        # générer avec : openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3001

# MinIO (stockage photos)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_PHOTOS=photos
MINIO_USE_SSL=false        # passer à true en production

# App
NODE_ENV=development
PORT=3001

# Logs (optionnel)
# Niveaux disponibles : trace | debug | info | warn | error | fatal
# Par défaut : "debug" en développement, "info" en production
# Utile pour réduire le bruit en dev ou activer le debug en prod sans toucher au code
LOG_LEVEL=
