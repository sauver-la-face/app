# =============================================================
# BACKEND — Variables d'environnement
# =============================================================
# Ordre de lecture (du plus prioritaire au moins prioritaire) :
#   1. .env.local              ← secrets locaux (jamais commité)
#   2. .env.test.local         ← si NODE_ENV=test + local (jamais commité)
#   3. .env.test               ← si NODE_ENV=test (commitable)
#   4. .env.development.local  ← si NODE_ENV=development + local (jamais commité)
#   5. .env.development        ← si NODE_ENV=development (commitable)
#   6. .env                    ← base, toujours chargé en dernier
#
# Copie ce fichier :
#   cp apps/backend/.env.example apps/backend/.env.local
# =============================================================

# Base de données
DATABASE_URL=postgresql://user:password@localhost:5432/sauver_la_face

# Better Auth
BETTER_AUTH_SECRET=        # générer avec : openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3001

# MinIO (stockage photos)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_PHOTOS=photos
MINIO_USE_SSL=false        # passer à true en production

# App
NODE_ENV=development
PORT=3001

# Missions (bloque les déploiements de schéma en CI/CD)
MISSION_ACTIVE=false
