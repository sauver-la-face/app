# Base de données
DATABASE_URL=postgresql://user:password@localhost:5432/sauver_la_face

# Better Auth
BETTER_AUTH_SECRET=                  # générer avec : openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3001

# MinIO (stockage photos)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_PHOTOS=photos
MINIO_USE_SSL=false                  # passer à true en production

# App
NODE_ENV=development
PORT=3001

# Missions (bloque les déploiements de schéma en CI/CD)
MISSION_ACTIVE=false
