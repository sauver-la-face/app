{
  "name": "@sauver-la-face/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": " dotenv -e .env.local -- bun run --watch src/index.ts",
    "start": "dotenv -e .env.local -- bun run src/index.ts",
    "test": "dotenv -e .env.local -- bun test",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:seed:sync01": "dotenv -e .env.local -- bun run scripts/seedSync01.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@better-auth/drizzle-adapter": "^1.6.9",
    "@hono/zod-openapi": "^0.16.0",
    "@sauver-la-face/shared": "workspace:*",
    "better-auth": "^1.0.0",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.0.0",
    "pg": "^8.20.0",
    "pino": "^9.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10"
  }
}
