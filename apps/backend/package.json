{
  "name": "@sauver-la-face/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": " dotenv -e .env.local -- bun run --watch src/index.ts",
    "start": "dotenv -e .env.local -- bun run src/index.ts",
    "test": "dotenv -e .env.local -- bun test",
    "test:unit": "dotenv -e .env.local -- bun test --path-ignore-patterns '**/*.integration.test.ts'",
    "test:integration": "dotenv -e .env.local -- bun test --pass-with-no-tests integration",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- bun run scripts/migrate.ts",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:seed:sync01": "dotenv -e .env.local -- bun run scripts/seedSync01.ts",
    "db:seed:med01": "dotenv -e .env.local -- bun run scripts/seedMed01.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^0.16.0",
    "@sauver-la-face/shared": "workspace:*",
    "better-auth": "^1.7.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pino": "^9.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10"
  }
}
