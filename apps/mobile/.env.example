# =============================================================
# MOBILE (Expo) — Variables d'environnement
# =============================================================
# Ordre de lecture (du plus prioritaire au moins prioritaire) :
#   1. .env.local   ← tes secrets locaux (jamais commité)
#   2. .env         ← valeurs par défaut (jamais commité non plus)
#
# Copie ce fichier :
#   cp apps/mobile/.env.example apps/mobile/.env.local
#
# Note : seules les variables préfixées EXPO_PUBLIC_ sont
# accessibles côté client. Les autres restent côté serveur.
# =============================================================

# URL de l'API backend
EXPO_PUBLIC_API_URL=http://localhost:3001
