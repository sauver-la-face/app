# =============================================================
# WEB (Next.js) — Variables d'environnement
# =============================================================
# Ordre de lecture (du plus prioritaire au moins prioritaire) :
#   1. .env.local              ← secrets locaux (jamais commité)
#   2. .env.test.local         ← si NODE_ENV=test + local (jamais commité)
#   3. .env.test               ← si NODE_ENV=test (commitable)
#   4. .env.development.local  ← si NODE_ENV=development + local (jamais commité)
#   5. .env.development        ← si NODE_ENV=development (commitable)
#   6. .env.production.local   ← si NODE_ENV=production + local (jamais commité)
#   7. .env.production         ← si NODE_ENV=production (commitable)
#   8. .env                    ← base, toujours chargé en dernier
#
# Copie ce fichier :
#   cp apps/web/.env.example apps/web/.env.local
#
# Note : seules les variables préfixées NEXT_PUBLIC_ sont
# accessibles côté client. Les autres restent côté serveur.
# =============================================================

# URL de l'API backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Pas de BETTER_AUTH_SECRET ici — validation des tokens déléguée au backend
