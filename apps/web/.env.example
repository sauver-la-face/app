# =============================================================
# WEB (Next.js) — Variables d'environnement
# =============================================================
# Ordre de lecture (du plus prioritaire au moins prioritaire) :
#   1. .env.local             ← tes secrets locaux (jamais commité)
#   2. .env.development.local ← dev + local (jamais commité)
#   3. .env.development       ← spécifique dev (commitable)
#   4. .env                   ← valeurs de base (commitable)
#
# Copie ce fichier :
#   cp apps/web/.env.example apps/web/.env.local
# =============================================================

# URL de l'API backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Pas de BETTER_AUTH_SECRET ici — validation des tokens déléguée au backend
