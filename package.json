{
  "name": "sauver-la-face",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "bun run --cwd apps/backend dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "docker:up:dev": "docker compose --profile dev --env-file .env.local up",
    "docker:build:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile prod --env-file .env.production build",
    "docker:up:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile prod --env-file .env.production up -d",
    "docker:down:dev": "docker compose --profile dev --env-file .env.local down",
    "docker:down:prod": "docker compose -f docker-compose.yml --env-file .env.local down",
    "lint": "bunx biome check .",
    "format": "bunx biome format --write .",
    "build:shared": "bun run --cwd packages/shared build",
    "test": "bun run --cwd apps/backend test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node-cron": "^3.0.11",
    "bun-types": "^1.4.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "node-cron": "^4.6.0"
  }
}
