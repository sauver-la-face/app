{
  "name": "sauver-la-face",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "bun run --cwd apps/backend dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "docker:up": "docker compose --env-file .env.local up",
    "docker:down": "docker compose --env-file .env.local down",
    "lint": "bunx biome check .",
    "format": "bunx biome format --write .",
    "build:shared": "bun run --cwd packages/shared build",
    "test": "bun test --recursive"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@types/node-cron": "^3.0.11",
    "bun-types": "^1.3.12",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "node-cron": "^4.2.1"
  }
}
