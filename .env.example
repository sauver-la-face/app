# =============================================================
# DOCKER COMPOSE — Variables d'environnement
# =============================================================
# Ordre de lecture (du plus prioritaire au moins prioritaire) :
#   1. .env.local   ← tes secrets locaux (jamais commité)
#   2. .env         ← valeurs par défaut (jamais commité non plus)
#
# Copie ce fichier :
#   cp .env.example .env.local
# =============================================================

# PostgreSQL
POSTGRES_USER=sauver
POSTGRES_PASSWORD=         # choisir un mot de passe fort
POSTGRES_DB=sauver_la_face
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=       # minimum 8 caractères
