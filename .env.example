# =============================================================
# DOCKER COMPOSE — Variables d'environnement
# =============================================================
# CE FICHIER EST COMMITÉ — ne jamais y mettre de secrets.
# Stratégie :
#   .env.example  ← documentation des variables (commité, sans secrets)
#   .env.local    ← overrides locaux du développeur (gitignorée, jamais en prod)
#   Production    ← variables injectées par la plateforme (Docker secrets, hébergeur)
#
# Pour démarrer en dev (avec pgAdmin) : docker compose --profile dev up
# Pour démarrer sans pgAdmin          : docker compose up
# =============================================================

# PostgreSQL
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sauver_la_face
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# pgAdmin (interface administration PostgreSQL — dev uniquement)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# Caddy (reverse proxy)
# dev   : localhost (certificat auto-signé interne)
# prod  : domaine réel (Let's Encrypt automatique)
CADDY_DOMAIN=localhost
