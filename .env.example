# =============================================================
# DOCKER COMPOSE — Variables d'environnement
# =============================================================
# CE FICHIER EST COMMITÉ — ne jamais y mettre de secrets.
# Stratégie :
#   .env.example  ← documentation des variables (commité)
#   .env.local    ← vraies valeurs locales (gitignorée)
#   Docker        ← injecte les variables en prod via --env-file
#
# Pour démarrer : docker compose --env-file .env.local up
# =============================================================

# PostgreSQL
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sauver_la_face
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# pgAdmin (interface administration PostgreSQL — dev uniquement)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
