{
  "permissions": {
    "allow": [
      "Bash(bun run lint *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"[[ \\\"$CLAUDE_TOOL_INPUT_FILE_PATH\\\" == *\\\".env.local\\\"* ]] && echo 'Édition .env.local bloquée — secrets DB et clés S3' && exit 2; exit 0\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"[[ \\\"$CLAUDE_TOOL_INPUT_FILE_PATH\\\" =~ \\\\.(ts|tsx|js|jsx)$ ]] && bunx biome check --write \\\"$CLAUDE_TOOL_INPUT_FILE_PATH\\\" 2>/dev/null; exit 0\""
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "figma": {
      "command": "npx",
      "args": ["-y", "figma-developer-mcp"],
      "env": {
        "FIGMA_API_KEY": "votre_clé_figma_dans_settings.local.json"
      }
    }
  }
}
